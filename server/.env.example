# Server only. Never use a VITE_ prefix or commit real credentials.
# Example selected by the user; runtime has no vendor/model defaults.
NEXUS_API_BASE_URL=https://opencode.ai/zen/go/v1
NEXUS_API_MODEL=deepseek-v4.1-flash
NEXUS_API_KEY=
# Set true only after explicitly checking that provider Use balance/overage is OFF.
NEXUS_OVERAGE_CONFIRMED_OFF=false
# Requires a separate explicit opt-in after all configuration is complete.
NEXUS_LIVE_ENABLED=false
NEXUS_MAX_OUTPUT_TOKENS=1200
NEXUS_MAX_CALLS=10
# Optional explicit compatibility control; unset preserves provider defaults.
# NEXUS_REASONING_EFFORT=low
# Isolated compatibility option; do not combine with NEXUS_REASONING_EFFORT.
# NEXUS_THINKING_MODE=disabled
