    "test:ui:live": "node scripts/test-ui-live.mjs",
    "test:e2e": "playwright test",
    "test:ui:race": "node scripts/test-ui-review-race.mjs",
    "test:ui:facts": "node scripts/test-ui-fact-review.mjs",
    "test:ui:controls": "node scripts/test-ui-generation-controls.mjs",
    "test:ui:storage": "node scripts/test-ui-storage.mjs",
    "test:ui:prose": "node scripts/test-ui-prose-pipeline.mjs",
    "test:ui:memory": "node scripts/test-ui-memory-review.mjs",
    "test:ui:multichapter": "node scripts/test-ui-multichapter.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.1",
    "vite": "^7.0.0"
